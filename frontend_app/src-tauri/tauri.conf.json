{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aethel",
  "version": "2.0.0-beta.1",
  "identifier": "com.aethel.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm bundle:prepare && pnpm dev",
    "beforeBuildCommand": "pnpm bundle:prepare && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aethel",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:8765; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 ws://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "payload/backend/": "backend/",
      "payload/requirements/": "requirements/",
      "payload/uv/": "uv/",
      "../../LICENSE": "LICENSE",
      "../../docs/third_party.md": "THIRD_PARTY.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Aethel: a companion that lives on your computer",
    "publisher": "CodexManvik",
    "copyright": "Copyright (c) 2026 CodexManvik. MIT licence.",
    "homepage": "https://github.com/CodexManvik/Aethel",
    "licenseFile": "../../LICENSE"
  }
}
