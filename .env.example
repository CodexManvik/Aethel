# ============================================
# PERSONA-AI ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# This is a template for the .env file
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# 1. MODEL & ENGINE CONFIGURATION
# ============================================
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_TIMEOUT=120

MODEL_PATH=C:\AI\models\realismByStableYogi_sd15V9.safetensors
IMAGE_GEN_TIMEOUT=60

EMOTION_MODEL_DIR=C:\AI\models\emotion_roberta_onnx
EMOTION_TOKENIZER_NAME=j-hartmann/emotion-english-distilroberta-base

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ============================================
# 2. MEMORY & DATABASE PATHS
# ============================================
TV_INDEX_PATH=backend/data/turbovec_memory.tvim
METADATA_PATH=backend/data/memory_metadata.json
GRAPH_DATABASE_PATH=backend/data/lancedb_data/relational_graph.json
CLASSIFIED_MEMORIES_PATH=backend/data/classified_memories.json
PERSONALITY_DATASET_PATH=backend/data/personality_dataset.json
PREFERENCES_PATH=backend/data/preferences.jsonl
MEMORY_TELEMETRY_PATH=backend/data/telemetry_logs.jsonl

# ============================================
# 3. RETRIEVAL ENGINE PARAMETERS
# ============================================
RETRIEVAL_INITIAL_K=8
RETRIEVAL_MAX_EXPLICIT_DOCS=1
RETRIEVAL_FINAL_RETURN_COUNT=3
TURBOVEC_BIT_WIDTH=4

# ============================================
# 4. GENERATION PARAMETERS
# ============================================
GENERATION_TEMPERATURE=0.85
GENERATION_TOP_P=0.9
GENERATION_FREQUENCY_PENALTY=0.1
GENERATION_PRESENCE_PENALTY=0.1
DEFAULT_ACTIVE_MODEL=default

# ============================================
# 5. EMOTIONAL BASELINE STATE
# ============================================
EMOTION_DELTA_MULTIPLIER=0.35

# ============================================
# 6. IMAGE GENERATION CONFIGURATION
# ============================================
TEMP_IMAGE_DIR={tempdir}/persona_ai_images
IMAGE_BASE_PROMPT=
IMAGE_NEGATIVE_PROMPT=
IMAGE_INFERENCE_STEPS=20
IMAGE_GUIDANCE_SCALE=7.5

# ============================================
# 7. MEDIA HANDLING
# ============================================
MEDIA_FRAMES_TO_EXTRACT=3
MEDIA_MAX_TEXT_LENGTH=400
MEDIA_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif,.mp4,.webm

# ============================================
# 8. SERVER CONFIGURATION
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
VIDEO_RECORDING_MODE=false
MAX_CONCURRENT_REQUESTS=1

# ============================================
# 9. BROKER/TUNNEL CONFIGURATION
# ============================================
CURRENT_RUNTIME_TUNNEL=http://localhost:8000
IS_DEVELOPER_PRESENT=true
BROKER_PORT=8001

# ============================================
# 10. WEB SEARCH CONFIGURATION
# ============================================
WEB_SEARCH_MAX_RESULTS=3

# ============================================
# 11. CONVERSATION & HISTORY
# ============================================
HISTORY_WINDOW_SIZE=12
SUMMARY_MESSAGE_WINDOW=8

# ============================================
# 12. PERSONA CONFIGURATION
# ============================================
BASE_PERSONA_NAME=Rosia
BASE_PERSONA_AGE=18
BASE_PERSONA_LOCATION=UK
BASE_PERSONA_VOICE_PLATFORM=Discord
MOOD_DESCRIPTION=sultry, highly personal, unfiltered, and effortlessly direct.
TIMEZONE=Europe/London

# ============================================
# 13. CONTENT FILTERING & SAFETY
# ============================================
EXPLICIT_WORDS=
ENABLE_CONTENT_GUARDRAILS=true

# ============================================
# 14. DEBUGGING & LOGGING
# ============================================
DEBUG_MODE=false
LOG_LEVEL=INFO
TELEMETRY_ENABLED=true
TELEMETRY_FLUSH_INTERVAL=60

# ============================================
# 15. PERFORMANCE & RESOURCE LIMITS
# ============================================
MAX_VRAM_ALLOCATION=4
EMOTION_CPU_ONLY=true

# ============================================
# 16. AGENT LOOP (RSM Phase 1)
# ============================================
# Multi-step agent cycle: generate -> tool call -> observe -> repeat.
# Set AGENT_LOOP_ENABLED=false to fall back to the legacy single-shot
# regex tool interception.
AGENT_LOOP_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_TOOL_RESULT_MAX_CHARS=6000

# Generation backend: "local" (llama.cpp) or "cloud" (any OpenAI-compatible
# /chat/completions endpoint). Cloud needs CLOUD_API_KEY.
GENERATION_BACKEND=local
CLOUD_API_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# Models folder (defaults to <project>/models with llm/ tts/ stt/ image/ inside)
# MODELS_DIR=C:\somewhere\else\models
LLAMA_STARTUP_TIMEOUT=120

# Speech
# Kokoro TTS + Whisper STT models fetch themselves on first startup.
# Set to false to place model files in models/tts and models/stt yourself.
AUTO_DOWNLOAD_SPEECH_MODELS=true
TTS_ENGINE=kokoro
TTS_KOKORO_VOICE=af_heart
TTS_KOKORO_SPEED=1.0
STT_ENABLED=true
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Image generation
# Master switch. Off by default (a local image model rarely fits alongside the
# LLM on small GPUs). Set true once you have the VRAM for it.
IMAGE_GEN_ENABLED=false
# IMAGE_MODEL_ARCH: auto | sd15 | zimage  (auto-detects from the model file)
IMAGE_MODEL_ARCH=auto
ZIMAGE_STEPS=8
ZIMAGE_GUIDANCE=1.0
ZIMAGE_WIDTH=1024
ZIMAGE_HEIGHT=1024
# VRAM handoff: suspend the LLM while generating an image so it can borrow the
# GPU, then resume it (conversation context is preserved). auto | true | false
IMAGE_GEN_VRAM_HANDOFF=auto
IMAGE_GEN_HANDOFF_VRAM_THRESHOLD=8

# ============================================
# 17. GRAPH MEMORY CONFIGURATION
# ============================================
GRAPH_ENTITY_CAREER=internship,startup,code,agent,rag,linux
GRAPH_ENTITY_FAMILY=father,cousin,family,parents
GRAPH_ENTITY_LIFESTYLE=bmw,car,music,gaming,setup
GRAPH_MIN_WEIGHT_THRESHOLD=1

# ============================================
# 18. TEXT NORMALIZATION
# ============================================
NORMALIZE_SLANG=true

# ============================================
# 19. FRONTEND CONFIGURATION (WEB APP)
# ============================================
VITE_API_BASE_URL=https://commissioner-twin-submitted-protest.trycloudflare.com

# ============================================
# 20. FRONTEND APP CONFIGURATION (TAURI DESKTOP)
# ============================================
VITE_BROKER_URL=http://localhost:9000
DEV_TUNNEL_URL=http://localhost:8000

# ============================================
# 21. TAURI DESKTOP APP SETTINGS
# ============================================
TAURI_PRODUCT_NAME=Aethel
TAURI_WINDOW_TITLE=Aethel Core
TAURI_WINDOW_WIDTH=800
TAURI_WINDOW_HEIGHT=600
VITE_DEV_PORT=5173
TAURI_DEV_URL=http://localhost:5173
TAURI_API_HOSTS=localhost:8000,localhost:9000
TAURI_APP_IDENTIFIER=com.aethel.app

ADMIN_PASSWORD=
MASTER_TOKEN=
ADMIN_TOKEN_SECRET=
REQUEST_STORAGE_PATH=backend/data/access_requests.json
APPROVED_TOKENS_PATH=backend/data/approved_tokens.json
# Conversational tone tracking (optional). Two dimensions:
# mood (unpleasant<->pleasant) and energy (low<->high activation).
# Off by default; nothing loads when disabled.
EMOTION_ENGINE_ENABLED=true
BASELINE_MOOD=0.0
BASELINE_ENERGY=0.0
EMOTION_DECAY_RATE=0.05
